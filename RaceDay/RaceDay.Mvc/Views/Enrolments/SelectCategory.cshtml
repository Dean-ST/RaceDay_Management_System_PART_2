@model List<RaceDay.Contracts.CategoryDto>

<h2>Select Your Category</h2>

@if (!Model.Any())
{
    <p>No categories are available for this event.</p>
}
else
{
    <form asp-controller="Enrolments" asp-action="Create" method="post">

        <input type="hidden" name="EventId" value="@ViewBag.EventId" />

        <div class="mb-3">
            <label>Select Category</label>

            <select name="CategoryId" class="form-control" required>
                <option value="">Choose your category</option>

                @foreach (var category in Model)
                {
                    <option value="@category.CategoryId">
                        Age Category: @category.Age
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Enrol Now
        </button>
    </form>
}