@model List<RaceDay.Contracts.EventDto>

<h2>Manage Events</h2>

<a asp-action="Create">Create New Event</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Date</th>
            <th>Location</th>
            <th>Distance</th>
            <th>Categories</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Date</td>
                <td>@item.Location</td>
                <td>@item.Distance</td>
                <td>
                    <a asp-controller="Categories"
                       asp-action="Index"
                       asp-route-eventId="@item.EventId">
                        Manage Categories
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>