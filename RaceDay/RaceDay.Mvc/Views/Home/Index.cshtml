<h1>RaceDay Dashboard</h1>

<h3>Welcome!</h3>

<p>You are logged in as: <strong>@ViewBag.Role</strong></p>

@if (ViewBag.Role == "Organiser")
{
    <h3>Organiser Dashboard</h3>
    <p>Manage events, categories, enrolments and results.</p>
}
else if (ViewBag.Role == "Participant")
{
    <h3>Participant Dashboard</h3>
    <p>Browse events, enrol in races and view your results.</p>
}