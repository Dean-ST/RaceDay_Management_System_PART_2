@model List<RaceDay.Contracts.ResultDto>

<h2>Event Results</h2>

@if (!Model.Any())
{
    <p>No results have been recorded yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Participant</th>
                <th>Category</th>
                <th>Finish Time</th>
                <th>Position</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model)
            {
                <tr>
                    <td>@result.ParticipantName</td>
                    <td>@result.CategoryAge</td>
                    <td>@result.FinishTime</td>
                    <td>@result.FinishPosition</td>
                </tr>
            }
        </tbody>
    </table>
}

<h3>Record a Result</h3>

<form asp-action="Create" method="post">
    <input type="hidden" name="eventId" value="@ViewBag.EventId" />

    <div class="mb-3">
        <label>Enrollment ID</label>
        <input type="number" name="EnrollmentId" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Finish Time</label>
        <input type="text" name="FinishTime" class="form-control"
               placeholder="00:35:20" required />
    </div>

    <div class="mb-3">
        <label>Finish Position</label>
        <input type="number" name="FinishPosition" class="form-control" min="1" required />
    </div>

    <button type="submit" class="btn btn-primary">Save Result</button>
</form>